{
  "name": "masoi-game",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --port 8081",
    "web": "expo start --web --port 8081",
    "server": "node server/index.js",
    "build": "expo export --platform web",
    "clean": "npx -y kill-port 8081 3001",
    "kill:node": "taskkill /F /IM node.exe",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "expo": "~52.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "express": "^4.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-web": "~0.19.13",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "@expo/metro-runtime": "~4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0"
  },
  "overrides": {
    "tar": ">=7.5.21",
    "postcss": ">=8.5.23",
    "node-forge": ">=1.3.1"
  },
  "private": true
}
